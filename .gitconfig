[user]
  name = Ayato-san
  email = dev.github.collision@p.ayato-san.fr

[core]
  autocrlf = false

[init]
  defaultBranch = main

[push]
  autoSetupRemote = true

[pull]
	rebase = true

[fetch]
  prune = true

[commit]
  template = "~/.gitmessage"

[alias]
  aliases = "!git config --get-regexp '^alias\\.'  | sort | awk 'BEGIN { printf \"%-15s │ %s\\n\", \"Alias\", \"Command\"; printf \"%-15s─┼─%s\\n\", \"───────────────\", \"────────────────────────────────────────\" } { name=$1; sub(/^alias\\./, \"\", name); $1=\"\"; sub(/^ /, \"\"); printf \"%-15s │ %s\\n\", name, $0 }'"

[credential "https://github.com"]
	helper = "!gh auth git-credential"

[credential "https://gist.github.com"]
	helper = "!gh auth git-credential"
